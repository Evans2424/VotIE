{"id": "M01_cm_024_2023-11-08_seg002", "text": " \n2. ALTERAÇÕES ORÇAMENTAIS PERMUTATIVAS PARA RATIFICAÇÃO\nPelo Senhor Presidente foram presentes a esta reunião as alterações orçamentais permutativas que se anexam à presente ata. \nPonderado e analisado o assunto o Executivo Municipal deliberou por maioria, com os votos a favor dos eleitos pelo PS e a abstenção da eleita pelo Nós, Cidadãos, ratificar as alterações orçamentais permutativas.", "spans": [{"start": 214, "end": 235, "label": "VOTER-FAVOR", "text": "o Executivo Municipal"}, {"start": 236, "end": 245, "label": "VOTING", "text": "deliberou"}, {"start": 246, "end": 257, "label": "COUNTING-MAJORITY", "text": "por maioria"}, {"start": 281, "end": 299, "label": "VOTER-FAVOR", "text": "os eleitos pelo PS"}, {"start": 315, "end": 342, "label": "VOTER-ABSTENTION", "text": "a eleita pelo Nós, Cidadãos"}, {"start": 357, "end": 392, "label": "SUBJECT", "text": "alterações orçamentais permutativas"}], "municipality": "M01", "document_id": "Alandroal_cm_024_2023-11-08", "segment_id": 2, "tokens": ["2", ".", "ALTERAÇÕES", "ORÇAMENTAIS", "PERMUTATIVAS", "PARA", "RATIFICAÇÃO", "Pelo", "Senhor", "Presidente", "foram", "presentes", "a", "esta", "reunião", "as", "alterações", "orçamentais", "permutativas", "que", "se", "anexam", "à", "presente", "ata", ".", "Ponderado", "e", "analisado", "o", "assunto", "o", "Executivo", "Municipal", "deliberou", "por", "maioria", ",", "com", "os", "votos", "a", "favor", "dos", "eleitos", "pelo", "PS", "e", "a", "abstenção", "da", "eleita", "pelo", "Nós", ",", "Cidadãos", ",", "ratificar", "as", "alterações", "orçamentais", "permutativas", "."], "labels": ["O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "B-VOTER-FAVOR", "I-VOTER-FAVOR", "I-VOTER-FAVOR", "B-VOTING", "B-COUNTING-MAJORITY", "I-COUNTING-MAJORITY", "O", "O", "O", "O", "O", "O", "B-VOTER-FAVOR", "I-VOTER-FAVOR", "I-VOTER-FAV